{
    "Logging": {
        "LogLevel": {
            "Default": "Debug",
            "System": "Information",
            "Microsoft": "Information"
        }
    },
    "Loki": {
        "Url": "http://loki:3100"
    },
    "OpenTelemetry": {
        "OtlpEndpoint": "http://tempo:4317"
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.Seq",
            "Serilog.Sinks.Grafana.Loki",
            "Serilog.Enrichers.ClientInfo"
        ],
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Information"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "Seq",
                "Args": {
                    "serverUrl": "http://seq:5341",
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3} {CorrelationId}] {Message}{NewLine}{Exception}"
                }
            },
            {
                "Name": "GrafanaLoki",
                "Args": {
                    "uri": "http://loki:3100",
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3} {CorrelationId}] {Message}{NewLine}{Exception}",
                    "labels": [
                        {
                            "key": "app",
                            "value": "courses-api"
                        }
                    ]
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId",
            {
                "Name": "WithCorrelationId",
                "Args": {
                    "headerName": "x-idempotency-key",
                    "addValueIfHeaderAbsence": true
                }
            }
        ],
        "Properties": {
            "Application": "CoursesAPI"
        }
    },
    "ConnectionStrings": {
        "Courses": "Server=sqlserver,1433;Database=SchoolCourses;User Id=SA;Password=Test123$;TrustServerCertificate=True;",
        "Redis-Cache": "redis-cache:6379"
    },
    "RabbitMq": {
        "Host": "msg_broker",
        "User": "rabbit",
        "Password": "travel@1"
    }
}